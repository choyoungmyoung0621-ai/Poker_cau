{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "friend-poker-room",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{"name": "ROOMS", "class_name": "PokerRoom"}]
  },
  "migrations": [
    {"tag":"v1", "new_sqlite_classes":["PokerRoom"]}
  ]
}
